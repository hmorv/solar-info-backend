# Example environment variables for solar-info-backend
DB_PASSWORD=your_db_password
DB_USER=dxsun
DB_NAME=dxsun
DB_HOST=localhost
LOG_PATH=/home/usuario/solar-api-access.log
NODE_ENV=development
PORT=3000
HOST=127.0.0.1

# Proveedor ionosferico: hybrid (por defecto), dias o giro.
IONOSPHERE_PROVIDER=hybrid
IONOSPHERE_PREFERRED_PROVIDER=dias
IONOSPHERE_AUTO_MAX_DISTANCE_KM=500
IONOSPHERE_MAX_OBSERVATION_AGE_MINUTES=30
# Limite de consultas secuenciales DIAS por seleccion automatica.
IONOSPHERE_AUTO_MAX_ATTEMPTS=3

# DIAS pagina registros de la ventana de validez individual configurada.
DIAS_TIMEOUT_MS=10000
DIAS_PARAMETER_MAX_AGE_MINUTES=30
DIAS_PARAMETER_MAX_PAGES=3
# Cache DIAS independiente; giro-cache.json sigue reservado a los datos GIRO existentes.
DIAS_CACHE_FILE=./data/dias-cache.json

# Cache GIRO existente y recuperacion temporal si el proveedor no esta disponible.
GIRO_CACHE_FILE=./data/giro-cache.json
GIRO_STALE_CACHE_MAX_MINUTES=360
